# Copy this file to .env for local development: cp .env.example .env

# Public URL of the deployed site. Used for canonical URLs and OG image links.
# Defaults to https://counter.uithing.com/ when unset (see nuxt.config.ts).
PUBLIC_URL=http://localhost:3000

# Secret used to sign OG image URLs. Leave empty to auto-generate one on each build.
# Set a stable value if you run multiple instances or roll deployments.
# Generate one with: bunx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=
