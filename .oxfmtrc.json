{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "vueIndentScriptAndStyle": true,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "type",
      { "newlinesBetween": true },
      ["parent", "sibling", "index"]
    ]
  },
  "sortTailwindcss": {
    "functions": ["tv"]
  },
  "ignorePatterns": ["app/components/Ui/**", "bun.lock", ".nuxt", ".output", "dist"]
}
