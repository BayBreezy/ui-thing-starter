{
  "name": "ui-thing-starter",
  "private": false,
  "author": {
    "name": "Behon Baker",
    "email": "behon.baker@yahoo.com",
    "url": "https://behonbaker.com"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "clean": "rm -rf .nuxt .output dist node_modules bun.lock && bun install",
    "dev": "nuxt dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "test": "vitest",
    "typecheck": "nuxt typecheck",
    "ui:add": "bunx --bun ui-thing@latest add"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.14.0",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^10.12.0",
    "motion-v": "^2.6.0",
    "nuxt": "^4.6.0",
    "nuxt-og-image": "^6.10.3",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/lucide": "^1.2.142",
    "@nuxt/test-utils": "^4.3.3",
    "@pinia/testing": "^2.0.1",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxtseo-layer-devtools": "^5.3.16",
    "oxfmt": "^0.72.0",
    "playwright-core": "^1.64.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2"
}
